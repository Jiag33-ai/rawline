<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- sideloaded app: lets the camera roll list RAW files such as RW2 that the phone does not call images -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- the render engine needs OpenGL ES 3.2: refuse to install where it is missing instead of failing at the first photo -->
    <uses-feature android:glEsVersion="0x00030002" android:required="true" />
    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:largeHeap="true"
        android:name=".RawlineApplication"
        android:label="Rawline"
        android:theme="@style/Theme.Rawline">
        <service android:name=".ExportService" android:exported="false" android:foregroundServiceType="dataSync|mediaProcessing" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
        <!-- configChanges: rotating or resizing must not rebuild the Activity (it would drop the editor's undo history and GL engine); Compose lays itself out again.
             singleTop: a tap on the export notification opens the Queue in the running app instead of stacking a second one. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
